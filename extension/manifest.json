{
  "manifest_version": 3,
  "name": "PokerJam ICM - ZenoSolver",
  "description": "POKER Jamのトーナメント履歴からZenoSolverとGTO WizardのICMフォームにテーブル設定を入力します。",
  "version": "1.0.1",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://zenosolver.com/*", "https://app.gtowizard.com/*", "https://api.github.com/*", "https://codeload.github.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "PokerJam ICM",
    "default_popup": "workspace.html"
  }
}
